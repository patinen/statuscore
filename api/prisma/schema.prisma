generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  githubId  String   @unique @db.VarChar(255)
  login     String   @db.VarChar(255)
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  monitors Monitor[]
  notificationChannels NotificationChannel[]
  statusPages StatusPage[]
  maintenanceWindows MaintenanceWindow[]
  manualIncidents ManualIncident[]
}

model Monitor {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @db.Uuid
  name                String    @db.VarChar(255)
  url                 String    @db.VarChar(2048)
  method              String    @default("GET") @db.VarChar(16)
  expectedStatusCode  Int       @default(200)
  intervalSeconds     Int       @default(60)
  timeoutMs           Int       @default(10000)
  failureThreshold    Int       @default(3)
  enabled             Boolean   @default(true)
  currentStatus       String    @default("UNKNOWN") @db.VarChar(32)
  consecutiveFailures Int       @default(0)
  lastCheckedAt       DateTime?
  nextCheckAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkResults          CheckResult[]
  incidents            Incident[]
  notificationChannels MonitorNotificationChannel[]
  statusPageAssociations StatusPageMonitor[]
  maintenanceWindowAssociations MaintenanceWindowMonitor[]
  manualIncidentAssociations ManualIncidentMonitor[]

  @@index([userId])
  @@index([enabled, nextCheckAt])
}

enum ManualIncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

enum ManualIncidentImpact {
  DEGRADED
  PARTIAL_OUTAGE
  MAJOR_OUTAGE
}

model ManualIncident {
  id         String               @id @default(uuid()) @db.Uuid
  userId     String               @db.Uuid
  title      String               @db.VarChar(150)
  status     ManualIncidentStatus
  impact     ManualIncidentImpact
  startedAt  DateTime
  resolvedAt DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  monitorAssociations ManualIncidentMonitor[]
  updates             ManualIncidentUpdate[]
  deliveries          NotificationDelivery[]

  @@index([userId, createdAt])
  @@index([userId, status, startedAt])
  @@index([userId, resolvedAt])
}

model ManualIncidentMonitor {
  manualIncidentId String   @db.Uuid
  monitorId        String   @db.Uuid
  createdAt        DateTime @default(now())

  manualIncident ManualIncident @relation(fields: [manualIncidentId], references: [id], onDelete: Cascade)
  monitor        Monitor        @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@id([manualIncidentId, monitorId])
  @@index([monitorId, manualIncidentId])
}

model ManualIncidentUpdate {
  id               String               @id @default(uuid()) @db.Uuid
  manualIncidentId String               @db.Uuid
  status           ManualIncidentStatus
  message          String               @db.VarChar(2000)
  createdAt        DateTime

  manualIncident ManualIncident @relation(fields: [manualIncidentId], references: [id], onDelete: Cascade)
  deliveries     NotificationDelivery[]

  @@index([manualIncidentId, createdAt])
}

model MaintenanceWindow {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  title       String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  startsAt    DateTime
  endsAt      DateTime
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  monitorAssociations MaintenanceWindowMonitor[]

  @@index([userId, createdAt])
  @@index([enabled, startsAt, endsAt])
}

model MaintenanceWindowMonitor {
  maintenanceWindowId String   @db.Uuid
  monitorId           String   @db.Uuid
  createdAt           DateTime @default(now())

  maintenanceWindow MaintenanceWindow @relation(fields: [maintenanceWindowId], references: [id], onDelete: Cascade)
  monitor           Monitor           @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@id([maintenanceWindowId, monitorId])
  @@index([monitorId, maintenanceWindowId])
}

enum NotificationChannelType {
  DISCORD
  WEBHOOK
}

enum NotificationDeliveryEventType {
  INCIDENT_OPENED
  INCIDENT_RESOLVED
  MANUAL_INCIDENT_OPENED
  MANUAL_INCIDENT_UPDATED
  MANUAL_INCIDENT_RESOLVED
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model NotificationChannel {
  id                String                   @id @default(uuid()) @db.Uuid
  userId            String                   @db.Uuid
  name              String                   @db.VarChar(100)
  type              NotificationChannelType
  endpointEncrypted String                   @db.VarChar(2048)
  enabled           Boolean                  @default(true)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  user                     User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  monitorAssociations      MonitorNotificationChannel[]
  deliveries               NotificationDelivery[]

  @@index([userId, enabled])
}

model MonitorNotificationChannel {
  monitorId String @db.Uuid
  channelId String @db.Uuid
  createdAt DateTime @default(now())

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  channel NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([monitorId, channelId])
  @@index([channelId])
}

model NotificationDelivery {
  id            String                       @id @default(uuid()) @db.Uuid
  userId        String                       @db.Uuid
  channelId     String?                      @db.Uuid
  channelName   String?                      @db.VarChar(100)
  channelType   NotificationChannelType?
  incidentId    String?                      @db.Uuid
  manualIncidentId String?                   @db.Uuid
  manualIncidentUpdateId String?             @db.Uuid
  eventType     NotificationDeliveryEventType
  occurredAt    DateTime?
  incidentTitleSnapshot String?              @db.VarChar(150)
  incidentImpactSnapshot ManualIncidentImpact?
  incidentStatusSnapshot ManualIncidentStatus?
  updateMessageSnapshot String?              @db.VarChar(2000)
  monitorNamesSnapshot Json?
  payloadSnapshot Json?
  status        NotificationDeliveryStatus   @default(PENDING)
  attemptCount  Int                          @default(0)
  nextAttemptAt DateTime?
  lastAttemptAt DateTime?
  sentAt        DateTime?
  lastError     String?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  channel               NotificationChannel?   @relation(fields: [channelId], references: [id], onDelete: SetNull)
  incident              Incident?              @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  manualIncident        ManualIncident?        @relation(fields: [manualIncidentId], references: [id], onDelete: SetNull)
  manualIncidentUpdate  ManualIncidentUpdate?  @relation(fields: [manualIncidentUpdateId], references: [id], onDelete: SetNull)

  @@unique([channelId, incidentId, eventType])
  @@unique([channelId, manualIncidentUpdateId, eventType])
  @@index([status, nextAttemptAt])
  @@index([userId, status, nextAttemptAt])
  @@index([channelId])
  @@index([incidentId])
  @@index([manualIncidentId])
  @@index([manualIncidentUpdateId])
}

model StatusPage {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  name        String    @db.VarChar(100)
  slug        String    @unique @db.VarChar(80)
  description String?   @db.VarChar(500)
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  monitorAssociations StatusPageMonitor[]

  @@index([userId, enabled])
}

model StatusPageMonitor {
  statusPageId String   @db.Uuid
  monitorId    String   @db.Uuid
  displayName  String?  @db.VarChar(100)
  position     Int      @default(0)
  createdAt    DateTime @default(now())

  statusPage StatusPage @relation(fields: [statusPageId], references: [id], onDelete: Cascade)
  monitor    Monitor    @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@id([statusPageId, monitorId])
  @@index([monitorId])
  @@index([statusPageId, position])
}

model CheckResult {
  id              String    @id @default(uuid()) @db.Uuid
  monitorId       String    @db.Uuid
  success         Boolean
  statusCode      Int?
  responseTimeMs  Int?
  errorType       String?
  errorMessage    String?
  checkedAt       DateTime  @default(now())

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, checkedAt])
}

model Incident {
  id         String    @id @default(uuid()) @db.Uuid
  monitorId  String    @db.Uuid
  startedAt  DateTime  @default(now())
  resolvedAt DateTime?
  reason     String?
  lastError  String?

  monitor    Monitor               @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([monitorId, startedAt])
  @@index([monitorId, resolvedAt])
}
