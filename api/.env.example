# Production template. For local HTTP development use NODE_ENV=development,
# localhost URLs, and the local PostgreSQL/Redis connection strings in README.md.
NODE_ENV=production
PORT=3001
CORS_ORIGIN=https://status.pat1.online
WEB_URL=https://status.pat1.online
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
GITHUB_CALLBACK_URL=https://api.status.pat1.online/auth/github/callback
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
# Replace hosts with the internal hostnames supplied by Coolify (not localhost).
DATABASE_URL=postgresql://statuscore:replace-with-password@postgres:5432/statuscore?schema=public
REDIS_URL=redis://default:replace-with-redis-password@redis:6379/0
MONITOR_WORKER_CONCURRENCY=10
NOTIFICATION_WORKER_CONCURRENCY=5
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Use the same key in API and worker; preserve it across redeployments.
NOTIFICATION_ENCRYPTION_KEY=replace-with-base64-32-byte-key
